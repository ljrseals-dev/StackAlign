# Establish a predictable environment before loading project modules.
if [ "${EUID:-0}" -eq 0 ] || [ "${EUID:-0}" -ne "${UID:-${EUID:-0}}" ]; then
  PATH=/usr/sbin:/usr/bin:/sbin:/bin
  export PATH
fi
IFS=$' \t\n'
umask 077
unset BASH_ENV ENV CDPATH GLOBIGNORE LD_PRELOAD LD_LIBRARY_PATH
#
# bin/stackalign -- CLI dispatcher. Written from master prompt v8 Part III.
# Implemented now: version, help, plan (alias), doctor (read-only), rollback.
# Every other subcommand is a recognised STUB that refuses with rc 2.
#
# ASSUMPTIONS (spec is partly contradictory/silent; unmeasured design choices):
#   * "--plan before command" and "each command has --plan" are reconciled as:
#     global flags (--plan --yes --config) go BEFORE the command; after the
#     command only that command's declared options are accepted (--plan/--apply,
#     rollback's --list/--to). Any other trailing option => "unexpected argument".
#   * Mutating commands default to plan mode; --apply is required to mutate.
#   * VERSION is a placeholder constant, not a release claim.
#   * `tune` is NOT wired: its config keys live in docs/TUNING.md (unavailable).
set -u

SA_VERSION="0.0.0-dev"
SA_SOURCE=${BASH_SOURCE[0]}
# Resolve symlinks only when present; the normal fast path uses Bash builtins.
while [ -L "$SA_SOURCE" ]; do
  SA_LINK_DIR=${SA_SOURCE%/*}
  [ "$SA_LINK_DIR" != "$SA_SOURCE" ] || SA_LINK_DIR=.
  SA_LINK_DIR=$(cd -P -- "$SA_LINK_DIR" && pwd -P) || exit 1
  SA_LINK=$(readlink -- "$SA_SOURCE") || exit 1
  case "$SA_LINK" in /*) SA_SOURCE=$SA_LINK ;; *) SA_SOURCE=$SA_LINK_DIR/$SA_LINK ;; esac
done
SA_DIR=${SA_SOURCE%/*}
[ "$SA_DIR" != "$SA_SOURCE" ] || SA_DIR=.
SA_ROOT=$(cd -- "$SA_DIR/.." && pwd -P)
source "$SA_ROOT/lib/exec.sh"
source "$SA_ROOT/lib/validate.sh"
SA_CONF_PATH=/etc/stackalign/stackalign.conf
GPLAN=0; YES=0

# Keep command metadata in Bash: no cat/awk subprocesses during dispatch.
_sa_known() {
  case "$1" in
    version|help|plan|install|doctor|tune|rollback|update|site|db|tls|backup|restore|bench|secret|repo|optimize|xcart|routine|internet|hosting|agent|sftp|egress|contain) return 0 ;;
    *) return 1 ;;
  esac
}

_sa_ms() {
  case "$1" in
    version|help|plan|doctor) printf '%s\n' M1 ;;
    install|tune|rollback|secret|repo|optimize) printf '%s\n' M2a ;;
    internet|hosting|agent) printf '%s\n' M2b ;;
    site|db|tls|xcart|routine|sftp) printf '%s\n' M3 ;;
    backup|restore|egress|contain) printf '%s\n' M4 ;;
    update) printf '%s\n' M5 ;;
    bench) printf '%s\n' M6 ;;
    *) return 1 ;;
  esac
}

_sa_cmd_list() {
  printf '%-9s %-5s %s\n' \
    version M1 'print version' \
    help M1 'per-subcommand help' \
    plan M1 'dry-run alias: plan <command> [args]' \
    install M2a 'plan then apply the full stack' \
    doctor M1 'read-only host and drift inspection' \
    tune M2a 'sizing planner' \
    rollback M2a 'snapshot restore: rollback [--list] [--to <id>]' \
    update M5 'update engine: check|plan|apply|pin|status' \
    site M3 'read-only vhost inventory/doctor; lifecycle actions gated' \
    db M3 'read-only database discovery/status/list/user inventory; create gated, drop blocked' \
    tls M3 'certificate status, client inventory, HTTP-01 plan, and scheduler preflight' \
    backup M4 'backup driver: run|list|verify' \
    restore M4 'restore driver: --from <id>' \
    bench M6 'reproducible benchmark' \
    secret M2a 'password and token generation: gen|list' \
    repo M2a 'read-only package repository inventory' \
    optimize M3 'read-only performance plan; apply is gated' \
    xcart M3 'guarded X-Cart profile: plan|preflight|build|deploy' \
    routine M3 'routine subsystem: plan|install|doctor|run|run-builtin' \
    internet M2b 'interactive internet access preferences and read-only planning' \
    hosting M2b 'hosting scope prompt, plans, and read-only inspection' \
    agent M2b 'Pinecone Neural planning sidecar: status or ask (read-only)' \
    sftp M3 'chrooted key-only SFTP account management' \
    egress M4 'outbound firewall and passive LAN audit' \
    contain M4 'evidence preservation before rebuild'
}

_sa_cmd_help() {
  case "$1" in
    version) printf 'stackalign version  [M1]\n  print version\n' ;;
    help) printf 'stackalign help  [M1]\n  per-subcommand help\n' ;;
    plan) printf 'stackalign plan  [M1]\n  dry-run alias: plan <command> [args]\n' ;;
    install) printf 'stackalign install  [M2a]\n  plan then apply the full stack\n' ;;
    doctor) printf 'stackalign doctor  [M1]\n  read-only host and drift inspection\n' ;;
    tune) printf 'stackalign tune  [M2a]\n  sizing planner\n' ;;
    rollback) printf 'stackalign rollback  [M2a]\n  snapshot restore: rollback [--list] [--to <id>]\n' ;;
    update) printf 'stackalign update  [M5]\n  update engine: check|plan|apply|pin|status\n' ;;
    site) printf 'stackalign site  [M3]\n  read-only vhost inventory/doctor; lifecycle actions gated\n' ;;
    db) printf 'stackalign db  [M3]\n  read-only discovery/status/list/user inventory; create gated, drop blocked\n' ;;
    tls) printf 'stackalign tls  [M3]\n  status, clients, plan-issue (Certbot HTTP-01 only), and scheduler preflight\n' ;;
    backup) printf 'stackalign backup  [M4]\n  backup driver: run|list|verify\n' ;;
    restore) printf 'stackalign restore  [M4]\n  restore driver: --from <id>\n' ;;
    bench) printf 'stackalign bench  [M6]\n  reproducible benchmark\n' ;;
    secret) printf 'stackalign secret  [M2a]\n  password and token generation: gen|list\n' ;;
    repo) printf 'stackalign repo  [M2a]\n  read-only package repository inventory\n' ;;
    optimize) printf 'stackalign optimize  [M3]\n  read-only performance plan; apply is gated\n' ;;
    xcart) printf 'stackalign xcart  [M3]\n  guarded X-Cart profile: plan|preflight|build|deploy\n' ;;
    routine) printf 'stackalign routine  [M3]\n  routine subsystem: plan|install|doctor|run|run-builtin\n' ;;
    internet) printf 'stackalign internet  [M2b]\n  interactive internet access preferences and read-only planning\n' ;;
    hosting) printf 'stackalign hosting  [M2b]\n  hosting scope prompt, plans, and read-only inspection\n' ;;
    agent) printf 'stackalign agent  [M2b]\n  Pinecone Neural planning sidecar: status or ask (read-only)\n' ;;
    sftp) printf 'stackalign sftp  [M3]\n  chrooted key-only SFTP account management\n' ;;
    egress) printf 'stackalign egress  [M4]\n  outbound firewall and passive LAN audit\n' ;;
    contain) printf 'stackalign contain  [M4]\n  evidence preservation before rebuild\n' ;;
    *) return 1 ;;
  esac
}

cmd_help() {
  if [ $# -ge 1 ]; then
    _sa_known "$1" || _sa_die "unknown command: $1"
    _sa_cmd_help "$1"
    return 0
  fi
  printf '%s\n' \
    'usage: stackalign [--plan] [--yes] [--config <file>] <command> [args]' \
    '       stackalign --version' \
    '' \
    'Global flags go BEFORE the command. Mutating commands only plan unless --apply.' \
    '' \
    'commands:'
  _sa_cmd_list
}

_sa_die() { echo "stackalign: $*" >&2; exit 64; }

cmd_version() { echo "stackalign $SA_VERSION"; }

# _sa_parse "<allowed options>" args...   sets APPLY PLAN_FLAG POS[] LIST TO
_sa_parse() {
  local allowed=" $1 "; shift
  APPLY=0; PLAN_FLAG=$GPLAN; POS=(); LIST=0; TO=""
  while [ $# -gt 0 ]; do
    case $1 in
      --plan|--apply|--list)
        [[ $allowed == *" $1 "* ]] || _sa_die "unexpected argument: $1"
        case $1 in --plan) PLAN_FLAG=1 ;; --apply) APPLY=1 ;; --list) LIST=1 ;; esac ;;
      --to)
        [[ $allowed == *" --to "* ]] || _sa_die "unexpected argument: $1"
        [ $# -ge 2 ] || _sa_die "--to needs an id"
        TO=$2; shift ;;
      -*) _sa_die "unexpected argument: $1" ;;
      *) POS+=("$1") ;;
    esac
    shift
  done
  [ "$APPLY" = 1 ] && [ "$PLAN_FLAG" = 1 ] && _sa_die "--plan and --apply are mutually exclusive"
  return 0
}

cmd_doctor() {
  _sa_parse "" "$@"; [ ${#POS[@]} -eq 0 ] || _sa_die "unexpected argument: ${POS[0]}"
  local crit=0 daemon rpm_output="" rpm_rc=0
  echo "doctor: read-only (no changes made)"
  if [ -f "$SA_CONF_PATH" ]; then
    source "$SA_ROOT/lib/config.sh"
    local errf; errf=$(mktemp) || return 1
    if sa_config_load "$SA_CONF_PATH" 2>"$errf"; then
      echo "config: ok ($SA_CONF_PATH)"
    else
      echo "config: ERROR ($SA_CONF_PATH): $(tr '\n' ' ' <"$errf")"; crit=1
    fi
    rm -f -- "$errf"
  else
    echo "config: not found ($SA_CONF_PATH), skipped"
  fi

  # One bounded RPM query replaces three serial package-manager startups.
  # RPM returns 1 when one or more requested packages are absent; its query
  # output still lists packages that are installed.
  if command -v rpm >/dev/null 2>&1; then
    if [ -x /usr/bin/timeout ]; then
      if rpm_output=$(/usr/bin/timeout --signal=TERM --kill-after=2 8s \
          rpm -q --qf '%{NAME}\n' vsftpd pure-ftpd proftpd 2>/dev/null); then
        rpm_rc=0
      else
        rpm_rc=$?
      fi
      case "$rpm_rc" in
        0|1)
          while IFS= read -r daemon; do
            case "$daemon" in
              vsftpd|pure-ftpd|proftpd)
                echo "NOTICE: independently managed FTP daemon detected: $daemon (StackAlign does not install or configure it)" ;;
            esac
          done <<< "$rpm_output"
          ;;
        124|137)
          echo "NOTICE: RPM package inspection timed out; FTP daemon check skipped" >&2 ;;
        *)
          echo "NOTICE: RPM package inspection failed (status $rpm_rc); FTP daemon check skipped" >&2 ;;
      esac
    else
      echo "NOTICE: timeout utility unavailable; FTP daemon check skipped" >&2
    fi
  fi
  [ "$crit" -eq 0 ] && echo "doctor: no critical findings" || echo "doctor: critical findings present"
  return "$crit"
}

cmd_install() {
  _sa_parse "--plan --apply" "$@"
  [ "${#POS[@]}" -eq 0 ] || _sa_die "usage: stackalign install [--plan|--apply]"
  source "$SA_ROOT/lib/lemp.sh"
  if [ "$APPLY" = 1 ] && [ "$PLAN_FLAG" = 0 ]; then
    sa_lemp_install apply
  else
    sa_lemp_install plan
    echo "(re-run with --apply to make changes)"
  fi
}
cmd_repo() {
  _sa_parse "" "$@"
  [ ${#POS[@]} -eq 1 ] && [ "${POS[0]}" = inventory ] || _sa_die "usage: stackalign repo inventory"
  source "$SA_ROOT/lib/repo.sh"
  sa_repo_inventory
}

cmd_optimize() {
  _sa_parse "--plan --apply" "$@"
  [ ${#POS[@]} -le 1 ] || _sa_die "usage: stackalign optimize [super] [--plan|--apply]"
  local mode=standard
  [ ${#POS[@]} -eq 0 ] || mode=${POS[0]}
  case "$mode" in standard|super) ;; *) _sa_die "optimize mode must be standard or super" ;; esac
  if [ "$APPLY" = 1 ]; then
    echo "stackalign: optimize --apply is not implemented; no changes made" >&2
    return 2
  fi
  source "$SA_ROOT/lib/optimize.sh"
  sa_optimize_plan "$mode"
}

cmd_rollback() {
  _sa_parse "--plan --apply --list --to" "$@"
  [ ${#POS[@]} -eq 0 ] || _sa_die "unexpected argument: ${POS[0]}"
  source "$SA_ROOT/lib/history.sh"
  if [ "$LIST" = 1 ]; then sa_history_list; return 0; fi
  [ -n "$TO" ] || _sa_die "rollback needs --list or --to <id>"
  local dir; dir=$(sa_history_path "$TO")
  [ -f "$dir/manifest" ] || { echo "stackalign: unknown snapshot id: $TO" >&2; return 1; }
  if [ "$APPLY" = 1 ]; then
    sa_history_rollback "$TO" && echo "rolled back: $TO"
  else
    echo "plan: would restore snapshot $TO; paths:"; cut -f2 "$dir/manifest" | sed 's/^/  /'
    echo "(re-run with --apply to make changes)"
  fi
}

cmd_site() {
  _sa_parse "--plan --apply" "$@"
  local sub=${POS[0]:-}
  source "$SA_ROOT/lib/site.sh"
  case "$sub" in
    list)
      [ "${#POS[@]}" -eq 1 ] && [ "$APPLY" = 0 ] || _sa_die "usage: stackalign site list"
      sa_site_list ;;
    doctor)
      [ "${#POS[@]}" -le 2 ] && [ "$APPLY" = 0 ] || _sa_die "usage: stackalign site doctor [nginx|apache|all]"
      sa_site_doctor "${POS[1]:-all}" ;;
    add)
      [ "${#POS[@]}" -eq 2 ] || _sa_die "usage: stackalign site add <domain> [--apply]"
      sa_site_add "${POS[1]}" ;;
    remove)
      [ "${#POS[@]}" -eq 2 ] || _sa_die "usage: stackalign site remove <domain> [--apply]"
      sa_site_remove "${POS[1]}" ;;
    isolate)
      [ "${#POS[@]}" -eq 2 ] || _sa_die "usage: stackalign site isolate <domain> [--apply]"
      sa_site_isolate "${POS[1]}" ;;
    *) _sa_die "usage: stackalign site <list|doctor [nginx|apache|all]|add|remove|isolate <domain>>" ;;
  esac
}

cmd_db() {
  _sa_parse "--plan --apply" "$@"
  local sub=${POS[0]:-}
  source "$SA_ROOT/lib/db.sh"
  case "$sub" in
    list)
      [ "${#POS[@]}" -eq 1 ] && [ "$APPLY" = 0 ] || _sa_die "usage: stackalign db list"
      sa_db_list ;;
    status)
      [ "${#POS[@]}" -eq 1 ] && [ "$APPLY" = 0 ] || _sa_die "usage: stackalign db status"
      sa_db_status ;;
    discover)
      [ "${#POS[@]}" -eq 1 ] && [ "$APPLY" = 0 ] || _sa_die "usage: stackalign db discover"
      sa_db_discover ;;
    user)
      [ "${#POS[@]}" -eq 2 ] && [ "${POS[1]}" = list ] && [ "$APPLY" = 0 ] || _sa_die "usage: stackalign db user list"
      sa_db_user_list ;;
    create)
      [ "${#POS[@]}" -eq 2 ] || _sa_die "usage: stackalign db create <database-name> [--apply]"
      sa_db_validate_name "${POS[1]}" || return $?
      if [ "$APPLY" = 1 ] && [ "$PLAN_FLAG" = 0 ]; then
        sa_db_create "${POS[1]}"
      else
        echo "plan: would create database ${POS[1]} with utf8mb4_unicode_ci if it does not exist"
        echo "no database state changed"
        echo "(re-run with --apply to create the database)"
      fi ;;
    drop)
      [ "${#POS[@]}" -eq 2 ] || _sa_die "usage: stackalign db drop <database-name> [--apply]"
      sa_db_drop "${POS[1]}" ;;
    *) _sa_die "usage: stackalign db <status|discover|list|user list|create <name> [--apply]|drop <name>>" ;;
  esac
}

cmd_tls() {
  local sub=${1:-} rc=0
  [ $# -gt 0 ] && shift
  source "$SA_ROOT/lib/tls.sh"
  case "$sub" in
    clients)
      [ $# -eq 0 ] || _sa_die "usage: stackalign tls clients"
      sa_tls_clients ;;
    status)
      [ $# -le 1 ] || _sa_die "usage: stackalign tls status [domain]"
      sa_tls_status "$@" ;;
    plan-issue)
      local domain=${1:-} client="" challenge="" webroot="" email=""
      [ $# -ge 1 ] || _sa_die "usage: stackalign tls plan-issue <domain> --client certbot --challenge http-01 --webroot <path> --email <address>"
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --client) [ $# -ge 2 ] || _sa_die "missing --client value"; client=$2; shift 2 ;;
          --challenge) [ $# -ge 2 ] || _sa_die "missing --challenge value"; challenge=$2; shift 2 ;;
          --webroot) [ $# -ge 2 ] || _sa_die "missing --webroot value"; webroot=$2; shift 2 ;;
          --email) [ $# -ge 2 ] || _sa_die "missing --email value"; email=$2; shift 2 ;;
          *) _sa_die "unknown tls plan-issue argument: $1" ;;
        esac
      done
      [ "$client" = certbot ] || _sa_die "TLS client must be explicitly certbot for HTTP-01 planning"
      [ "$challenge" = http-01 ] || _sa_die "Certbot plan requires --challenge http-01"
      sa_tls_certbot_http01_plan "$domain" "$webroot" "$email" ;;
    preflight)
      [ $# -eq 0 ] || _sa_die "usage: stackalign tls preflight"
      sa_tls_preflight || rc=$?
      if [ "$rc" -eq 0 ]; then
        echo "tls preflight: no active upstream renewal schedulers detected"
        return 0
      fi
      if [ "$rc" -eq 2 ]; then
        echo "tls preflight: renewal scheduler conflict; no changes made" >&2
        return 2
      fi
      return "$rc" ;;
    issue|renew|migrate|enable-renewal)
      echo "tls: $sub BLOCKED — issuance, renewal and client migration require protected secret transport, atomic certificate/key activation, and crash-safe rollback" >&2
      return 2 ;;
    *) _sa_die "usage: stackalign tls <clients|status [domain]|plan-issue <domain> --client certbot --challenge http-01 --webroot <path> --email <address>|preflight|issue|renew|migrate|enable-renewal>" ;;
  esac
}

cmd_backup() {
  _sa_parse "--plan --apply" "$@"
  local sub=${POS[0]:-} kind dest
  source "$SA_ROOT/lib/backup.sh"
  case "$sub" in
    run)
      [ "${#POS[@]}" -eq 3 ] || _sa_die "usage: stackalign backup run <logical|physical> <absolute-destination> [--apply]"
      kind=${POS[1]}; dest=${POS[2]}
      case "$kind" in logical|physical) ;; *) _sa_die "backup type must be logical or physical" ;; esac
      if [ "$APPLY" = 1 ] && [ "$PLAN_FLAG" = 0 ]; then
        if [ "$kind" = logical ]; then sa_backup_dump "$dest"; else sa_backup_physical "$dest"; fi
      else
        if [ "$kind" = logical ]; then
          echo "plan: would create a compressed all-databases logical dump under $dest"
        else
          echo "plan: would create and prepare a new MariaBackup directory $dest"
        fi
        echo "no backup files or database state changed"
        echo "(re-run with --apply to create the backup)"
      fi
      ;;
    list)
      [ "${#POS[@]}" -eq 2 ] && [ "$APPLY" = 0 ] && [ "$PLAN_FLAG" = 0 ] || _sa_die "usage: stackalign backup list <absolute-directory>"
      sa_backup_list "${POS[1]}" ;;
    verify)
      [ "${#POS[@]}" -eq 2 ] && [ "$APPLY" = 0 ] && [ "$PLAN_FLAG" = 0 ] || _sa_die "usage: stackalign backup verify <absolute-artifact>"
      sa_backup_verify "${POS[1]}" ;;
    *) _sa_die "usage: stackalign backup <run <logical|physical> <destination> [--apply]|list <directory>|verify <artifact>>" ;;
  esac
}

cmd_restore() {
  local from="" apply=0 plan=$GPLAN
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) [ $# -ge 2 ] || _sa_die "restore --from needs an artifact path"; from=$2; shift ;;
      --apply) apply=1 ;;
      --plan) plan=1 ;;
      *) _sa_die "unexpected argument: $1" ;;
    esac
    shift
  done
  [ -n "$from" ] || _sa_die "usage: stackalign restore --from <backup-artifact> [--apply]"
  if [ "$apply" = 1 ] && [ "$plan" = 1 ]; then _sa_die "restore --plan and --apply are mutually exclusive"; fi
  echo "stackalign restore: BLOCKED — no verified pre-restore snapshot, engine-specific recovery, or failure rollback contract exists; no database changes made" >&2
  return 2
}

cmd_secret() {  # secret gen <name> | secret list
  _sa_parse "--plan --apply" "$@"
  local sub=${POS[0]:-}
  source "$SA_ROOT/lib/secret.sh"
  case $sub in
    list)
      [ ${#POS[@]} -eq 1 ] || _sa_die "unexpected argument: ${POS[1]}"
      sa_secret_list ;;
    gen)
      [ ${#POS[@]} -eq 2 ] || _sa_die "usage: stackalign secret gen <name>"
      local mode=machine
      if [ -f "$SA_CONF_PATH" ]; then
        source "$SA_ROOT/lib/config.sh"
        sa_config_load "$SA_CONF_PATH" 2>/dev/null || { echo "stackalign: config error in $SA_CONF_PATH (run: stackalign doctor)" >&2; return 1; }
        mode=$(sa_config_get security.password_mode machine)
        [ -n "${SA_WORDLIST:-}" ] || SA_WORDLIST=$(sa_config_get security.passphrase_wordlist "")
        export SA_WORDLIST
      fi
      if [ "$APPLY" = 1 ] && [ "$PLAN_FLAG" = 0 ]; then SA_MODE=apply; else SA_MODE=plan; fi
      export SA_MODE
      local grc=0
      sa_secret_gen "${POS[1]}" "$mode" || grc=$?
      if [ "$SA_MODE" = plan ] && [ $grc -eq 0 ]; then echo "(re-run with --apply to make changes)"; fi
      return $grc ;;
    *) _sa_die "usage: stackalign secret <gen <name>|list>" ;;
  esac
}

cmd_update_plan() {
  _sa_parse "" "$@"
  [ "${#POS[@]}" -eq 3 ] && [ "${POS[0]}" = plan ] || \
    _sa_die "usage: stackalign update plan <component> <version>"

  local component=${POS[1]} target_version=${POS[2]}
  local package service current_nevra target_nevra config_paths health_check
  case "$component" in
    nginx)
      package=nginx; service=nginx
      config_paths="/etc/nginx"
      health_check="nginx -t"
      ;;
    php)
      package=php-fpm; service=php-fpm
      config_paths="/etc/php.ini /etc/php-fpm.conf /etc/php-fpm.d"
      health_check="php-fpm -t"
      ;;
    mariadb)
      package=MariaDB-server; service=mariadb
      config_paths="/etc/my.cnf /etc/my.cnf.d"
      health_check="mysqladmin ping"
      ;;
    *) _sa_die "unsupported update component: $component" ;;
  esac
  [[ $target_version =~ ^[A-Za-z0-9][A-Za-z0-9._:~+-]*$ ]] || \
    _sa_die "invalid target version"

  echo "=== UPDATE PLAN: $component -> $target_version ==="
  current_nevra=$(sa_exec rpm -- -q --qf '%{NEVRA}' -- "$package" 2>/dev/null) || \
    _sa_die "error: package $package is not installed"
  [ -n "$current_nevra" ] || _sa_die "error: rpm returned an empty current NEVRA"
  echo "  Current: $current_nevra"

  # --cacheonly prevents repository metadata refresh; logfile=/dev/null avoids
  # DNF's normal persistent logfile. Planning refuses if usable metadata is absent.
  target_nevra=$(sa_exec dnf --timeout 120 -- --cacheonly --setopt=logfile=/dev/null \
    repoquery --latest-limit 1 --qf '%{NEVRA}' -- "$package-$target_version" 2>/dev/null) || \
    _sa_die "error: cached repository metadata unavailable or DNF repoquery failed; refresh metadata separately, then retry"
  target_nevra=$(printf '%s\n' "$target_nevra" | awk 'NF { if (++n == 1) v=$0 } END { if (n == 1) print v; else exit 1 }') || \
    _sa_die "error: target did not resolve to exactly one NEVRA"
  [[ $target_nevra =~ ^[A-Za-z0-9][A-Za-z0-9+._:~%-]*-[A-Za-z0-9][A-Za-z0-9+._~%-]*-[A-Za-z0-9][A-Za-z0-9+._~%-]*\.[A-Za-z0-9_]+$ ]] || \
    _sa_die "error: DNF returned a malformed target NEVRA"
  echo "  Target:  $target_nevra"

  if [ "$current_nevra" = "$target_nevra" ]; then
    echo "  Result:  Already at requested NEVRA; no package action needed."
    echo "=== END PLAN (no StackAlign changes made) ==="
    return 0
  fi

  echo "  Tested:  NOT VERIFIED — vendor/versions.toml has no populated tested_matrix entry for this package policy."
  echo "  WARNING: target is not established as tested; this plan does not authorize apply."
  echo "  Snapshot: would create ${SA_HISTORY_ROOT:-/etc/stackalign/.history}/<UTC timestamp>-pre-update-$component containing:"
  local p
  for p in $config_paths; do echo "    $p"; done
  echo "  Services: $service would be restarted after package installation."
  echo "  Health check: $health_check"
  echo "  Downtime: service restart is expected; duration is environment-dependent and cannot be estimated here."
  echo "  DNF effects: package/dependency transaction preview is NOT included in this plan."
  echo "=== END PLAN (no StackAlign changes made) ==="
}

cmd_update() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    apply)
      { [ $# -eq 3 ] || [ $# -eq 4 ]; } || {
        echo "usage: stackalign update apply <package> <target_nevra> <service> [snapshot_path]" >&2
        return 64
      }
      # Load update-only dependencies only for the mutating update path.
      source "$SA_ROOT/lib/common.sh"
      source "$SA_ROOT/lib/repo_cache.sh"
      source "$SA_ROOT/lib/update.sh"
      source "$SA_ROOT/lib/history.sh"
      source "$SA_ROOT/lib/service.sh"
      sa_update_apply "$@"
      return $? ;;
    plan)
      cmd_update_plan plan "$@"
      return $? ;;
    check|pin|status)
      echo "update $sub: not implemented" >&2; return 2 ;;
    *)
      echo "usage: stackalign update check|plan|apply|pin|status" >&2; return 64 ;;
  esac
}

cmd_hosting() {
  _sa_parse "--plan" "$@"
  local sub=${POS[0]:-}
  source "$SA_ROOT/lib/hosting.sh"
  case "$sub" in
    plan)
      [ "${#POS[@]}" -eq 2 ] || _sa_die "usage: stackalign hosting plan <nginx|apache|hybrid>"
      sa_hosting_plan "${POS[1]}" ;;
    setup)
      [ "${#POS[@]}" -eq 1 ] || _sa_die "usage: stackalign hosting setup"
      sa_hosting_setup ;;
    doctor)
      [ "${#POS[@]}" -le 2 ] || _sa_die "usage: stackalign hosting doctor [nginx|apache|hybrid]"
      sa_hosting_doctor "${POS[1]:-hybrid}" ;;
    apply)
      echo "stackalign hosting apply: BLOCKED — isolation and real-host acceptance gates are incomplete; no changes made" >&2
      return 2 ;;
    *) _sa_die "usage: stackalign hosting <setup|plan <nginx|apache|hybrid>|doctor [mode]|apply>" ;;
  esac
}


cmd_internet() {
  _sa_parse "" "$@"
  local sub=${POS[0]:-}
  source "$SA_ROOT/lib/internet.sh"
  case "$sub" in
    setup)
      [ "${#POS[@]}" -eq 1 ] || _sa_die "usage: stackalign internet setup"
      sa_internet_setup ;;
    plan)
      [ "${#POS[@]}" -eq 1 ] || _sa_die "usage: stackalign internet plan"
      sa_internet_show_saved_plan ;;
    doctor)
      [ "${#POS[@]}" -eq 1 ] || _sa_die "usage: stackalign internet doctor"
      sa_internet_doctor ;;
    apply)
      echo "stackalign internet apply: BLOCKED — provider auth, DNS ownership, firewall and tunnel acceptance are not implemented; no changes made" >&2
      return 2 ;;
    *) _sa_die "usage: stackalign internet <setup|plan|doctor|apply>" ;;
  esac
}


cmd_agent() {
  local sub=${1:-}; shift || true
  source "$SA_ROOT/lib/agent.sh"
  case "$sub" in
    status)
      [ $# -eq 0 ] || _sa_die "usage: stackalign agent status"
      sa_agent_status ;;
    ask)
      [ $# -ge 1 ] || _sa_die "usage: stackalign agent ask <question>"
      sa_agent_ask "$@" ;;
    *)
      _sa_die "usage: stackalign agent <status|ask <question>>" ;;
  esac
}

cmd_sftp() {
  _sa_parse "--plan --apply" "$@"
  local sub=${POS[0]:-}
  source "$SA_ROOT/lib/sftp.sh"
  case "$sub" in
    list)
      [ ${#POS[@]} -eq 1 ] || _sa_die "usage: stackalign sftp list"
      sa_sftp_list ;;
    enable)
      [ ${#POS[@]} -eq 1 ] || _sa_die "usage: stackalign sftp enable [--apply]"
      if [ "$APPLY" = 1 ] && [ "$PLAN_FLAG" = 0 ]; then sa_sftp_enable
      else echo "plan: would install the SFTP sshd drop-in and reload sshd"; fi ;;
    add)
      [ ${#POS[@]} -eq 3 ] || _sa_die "usage: stackalign sftp add <user> <public-key-file> [--apply]"
      if [ "$APPLY" = 1 ] && [ "$PLAN_FLAG" = 0 ]; then sa_sftp_add_user "${POS[1]}" "${POS[2]}"
      else echo "plan: would create or rotate SFTP account ${POS[1]} using key file ${POS[2]}"; fi ;;
    remove)
      [ ${#POS[@]} -eq 2 ] || _sa_die "usage: stackalign sftp remove <user> [--apply]"
      if [ "$APPLY" = 1 ] && [ "$PLAN_FLAG" = 0 ]; then sa_sftp_remove_user "${POS[1]}"
      else echo "plan: would remove SFTP login ${POS[1]}; user data would be kept"; fi ;;
    *) _sa_die "usage: stackalign sftp <enable|add|remove|list>" ;;
  esac
}

cmd_egress() {
  _sa_parse "--plan --apply" "$@"
  local sub=${POS[0]:-}
  source "$SA_ROOT/lib/egress.sh"
  case "$sub" in
    plan)
      [ "${#POS[@]}" -ge 3 ] && [ "${#POS[@]}" -le 4 ] || _sa_die "usage: stackalign egress plan <allowlist> <dns-csv> [lan-csv|none]"
      sa_egress_render "${POS[1]}" "${POS[2]}" "${POS[3]:-none}" || return $?
      echo "# plan only: no firewall changes made"
      ;;
    apply)
      [ "${#POS[@]}" -ge 3 ] && [ "${#POS[@]}" -le 5 ] || _sa_die "usage: stackalign egress apply <allowlist> <dns-csv> [lan-csv|none] [revert-seconds] [--apply]"
      if [ "$APPLY" != 1 ]; then
        sa_egress_render "${POS[1]}" "${POS[2]}" "${POS[3]:-none}" || return $?
        echo "# plan only; rerun with --apply to load (prefer a local console and revert timer)"
        return 0
      fi
      sa_egress_apply "${POS[1]}" "${POS[2]}" "${POS[3]:-none}" "${POS[4]:-0}"
      ;;
    confirm|remove)
      [ "${#POS[@]}" -eq 1 ] || _sa_die "usage: stackalign egress $sub --apply"
      [ "$APPLY" = 1 ] || _sa_die "egress $sub changes firewall state; pass --apply explicitly"
      if [ "$sub" = confirm ]; then sa_egress_confirm; else sa_egress_remove; fi
      ;;
    audit)
      [ "${#POS[@]}" -eq 2 ] || _sa_die "usage: stackalign egress audit <known-devices-file>"
      sa_lan_audit "${POS[1]}"
      ;;
    *) _sa_die "usage: stackalign egress <plan|apply|confirm|remove|audit> ..." ;;
  esac
}

_sa_stub() {  # <cmd> args...
  local c=$1 ms
  shift
  _sa_parse "--plan --apply" "$@"
  ms=$(_sa_ms "$c") || ms=unknown
  echo "stackalign: '$c' is not implemented yet (milestone $ms)" >&2
  return 2
}

_sa_dispatch() {  # <cmd> args...
  local c=$1; shift
  _sa_known "$c" || _sa_die "unknown command: $c (try: stackalign help)"
  case $c in
    version)  _sa_parse "" "$@"; [ ${#POS[@]} -eq 0 ] || _sa_die "unexpected argument: ${POS[0]}"; cmd_version ;;
    help)     cmd_help "$@" ;;
    plan)     [ $# -ge 1 ] || _sa_die "plan needs a command"; GPLAN=1; _sa_dispatch "$@" ;;
    install)  cmd_install "$@" ;;
    doctor)   cmd_doctor "$@" ;;
    rollback) cmd_rollback "$@" ;;
    secret)   cmd_secret "$@" ;;
    repo)     cmd_repo "$@" ;;
    optimize) cmd_optimize "$@" ;;
    update)   cmd_update "$@" ;;
    hosting)  cmd_hosting "$@" ;;
    internet) cmd_internet "$@" ;;
    site)     cmd_site "$@" ;;
    db)       cmd_db "$@" ;;
    tls)      cmd_tls "$@" ;;
    agent)    cmd_agent "$@" ;;
    backup)   cmd_backup "$@" ;;
    restore)  cmd_restore "$@" ;;
    sftp)     cmd_sftp "$@" ;;
    egress)   cmd_egress "$@" ;;
    *)        _sa_stub "$c" "$@" ;;
  esac
}

main() {
  while [ $# -gt 0 ]; do
    case $1 in
      --version) cmd_version; exit 0 ;;          # ignores --plan: no side effects
      -h|--help) cmd_help; exit 0 ;;
      --plan) GPLAN=1 ;;
      # TODO(M2b): exported for future confirmation-gated mutating commands.
      --yes)  YES=1; export YES ;;
      --config) [ $# -ge 2 ] || _sa_die "--config needs a file"; SA_CONF_PATH=$2; shift ;;
      --config=*) SA_CONF_PATH=${1#--config=} ;;
      --) shift; break ;;
      -*) _sa_die "unexpected argument: $1" ;;
      *) break ;;
    esac
    shift
  done
  [ $# -ge 1 ] || { cmd_help >&2; exit 64; }
  _sa_dispatch "$@"
  exit $?
}

main "$@"
