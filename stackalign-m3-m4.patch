+sa_sftp_remove_user alice >/dev/null 2>&1; check "remove sftp user ok" "$?" 0
+grep -q "userdel -- alice" "$CALLS" && ! grep -q -- "userdel -r" "$CALLS"; check "userdel without -r" "$?" 0
+[ -e "$T/keys/alice" ]; check "key removed" "$?" 1
