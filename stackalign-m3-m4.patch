+: > "$CALLS"; sa_backup_physical "$T/phys" >/dev/null 2>&1; check "physical ok" "$?" 0
+grep -q -- "--backup --target-dir=$T/phys" "$CALLS"; check "backup called" "$?" 0
+grep -q -- "--prepare --target-dir=$T/phys" "$CALLS"; check "prepare called" "$?" 0
+sa_backup_physical "$T/phys" >/dev/null 2>&1; check "existing target refused" "$?" 1
+
+mkdir -p "$T/src"
