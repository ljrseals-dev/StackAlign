diff --git a/lib/repo_cache.sh b/lib/repo_cache.sh
--- a/lib/repo_cache.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/repo_cache.sh	2026-11-14 03:42:58.903808655 +0000
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# lib/repo_cache.sh -- verified RPM cache keyed by exact NEVRA.
+# Usage: sa_cache_get <nevra>   -> prints cached rpm path (only) on stdout.
+# Every path returns non-zero on failure; dnf output goes to stderr.
+
+: "${SA_RPM_CACHE:=/var/cache/stackalign/rpms}"
+
+# NEVRA charset only; no slashes, globs, spaces, or leading '-'/'.'.
+_sa_nevra_valid() {
+    [[ "$1" =~ ^[A-Za-z0-9_+][A-Za-z0-9._+~^:-]*$ ]] && [[ "$1" != *..* ]]
+}
+
+# Signature/integrity OK AND the file's own NEVRA equals the request.
+_sa_rpm_verify() {
+    local f="$1" want="$2" got
+    [ -f "$f" ] && [ ! -L "$f" ] || return 1
+    rpm --checksig "$f" >/dev/null 2>&1 || return 1
+    got="$(rpm -qp --qf '%{NEVRA}' "$f" 2>/dev/null)" || return 1
+    [ "$got" = "$want" ]
+}
+
+_sa_cache_fetch() {   # $1 nevra  $2 tmpdir  $3 final path
+    local nevra="$1" tmp="$2" final="$3" rpms=()
+    dnf -y download --destdir "$tmp" "$nevra" >&2 || return 1
+    shopt -s nullglob
+    rpms=("$tmp"/*.rpm)
+    shopt -u nullglob
+    [ "${#rpms[@]}" -eq 1 ] || return 1                 # exactly one RPM
+    _sa_rpm_verify "${rpms[0]}" "$nevra" || return 1    # exact identity
+    mv -f "${rpms[0]}" "$final"
+}
+
+sa_cache_get() {
+    local nevra="${1:-}" final tmp rc
+    _sa_nevra_valid "$nevra" || return 1
+    mkdir -p "$SA_RPM_CACHE" || return 1
+    final="$SA_RPM_CACHE/${nevra//:/_}.rpm"
+
+    # Cache hit: exact name only, re-verified (signature + NEVRA).
+    if _sa_rpm_verify "$final" "$nevra"; then
+        printf '%s\n' "$final"; return 0
+    fi
+
+    tmp="$(mktemp -d "$SA_RPM_CACHE/.dl.XXXXXX")" || return 1
+    _sa_cache_fetch "$nevra" "$tmp" "$final"; rc=$?
+    rm -rf "$tmp"                                        # every path cleans up
+    [ "$rc" -eq 0 ] || return 1
+    printf '%s\n' "$final"
+}
diff --git a/lib/security.sh b/lib/security.sh
--- a/lib/security.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/security.sh	2026-11-14 03:42:59.531808678 +0000
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# lib/security.sh -- advisory ClamAV scan of docroots. Never quarantines or deletes.
+# Findings are appended as JSON lines to SA_AUDIT_QUEUE. YARA is deferred to M7.
+. "$(dirname "${BASH_SOURCE[0]}")/common.sh"
+
+: "${SA_AUDIT_QUEUE:=/etc/stackalign/audit/queue.jsonl}"
+
+_sa_sec_esc() {
+    local s=$1
+    s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
+    printf '%s' "$s"
+}
+
+# sa_security_scan <docroot>...  rc 0 scan ran (findings advisory) | 2 scanner error | 64 bad args
+sa_security_scan() {
+    [ $# -ge 1 ] || { echo "usage: sa_security_scan <docroot>..." >&2; return 64; }
+    local d out rc line path sig n=0
+    for d in "$@"; do
+        [[ $d == /* && -d $d ]] || { echo "security: not an absolute existing dir: $d" >&2; return 64; }
+    done
+    mkdir -p "$(dirname "$SA_AUDIT_QUEUE")" || return 2
+    for d in "$@"; do
+        rc=0
+        out="$(clamscan -r --infected --no-summary -- "$d" 2>/dev/null)" || rc=$?
+        [ $rc -le 1 ] || { echo "security: clamscan failed on $d (rc=$rc)" >&2; return 2; }
+        while IFS= read -r line; do
+            [[ $line == *" FOUND" ]] || continue
+            path=${line%: *}; sig=${line##*: }; sig=${sig% FOUND}
+            printf '{"severity":"HIGH","component":"clamav","path":"%s","signature":"%s","action":"none"}\n' \
+                "$(_sa_sec_esc "$path")" "$(_sa_sec_esc "$sig")" >> "$SA_AUDIT_QUEUE"
+            n=$((n + 1))
+        done <<< "$out"
+    done
+    echo "security: $n finding(s) queued at $SA_AUDIT_QUEUE (advisory; nothing was changed)"
+}
diff --git a/lib/sftp.sh b/lib/sftp.sh
--- a/lib/sftp.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/sftp.sh	2026-11-14 03:42:59.919808692 +0000
@@ -0,0 +1,95 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# lib/sftp.sh -- chrooted, key-only SFTP accounts (the replacement for an FTP daemon).
+# Uses sshd's internal-sftp inside a Match Group drop-in. No password logins, no shell,
+# no forwarding. Existing system accounts are never converted or deleted.
+# ASSUMPTIONS to verify on a throwaway host: your sshd includes sshd_config.d/*.conf
+# and a Match block in that drop-in does not leak into later directives (check with
+# `sshd -T -C user=alice,addr=127.0.0.1`); sshd -t passes before every reload.
+. "$(dirname "${BASH_SOURCE[0]}")/common.sh"
+
+: "${SA_SFTP_GROUP:=sftponly}"
+: "${SA_SFTP_BASE:=/srv/sftp}"
+: "${SA_SFTP_KEYDIR:=/etc/ssh/sftp_keys}"
+: "${SA_SFTP_DROPIN:=/etc/ssh/sshd_config.d/50-stackalign-sftp.conf}"
+
+_sa_sftp_user_ok() { [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && [ "$1" != root ]; }
+# Plain public keys only: no authorized_keys options (command=, from=, ...).
+_sa_sftp_key_ok() {
+    [[ $1 =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com)[\ ][A-Za-z0-9+/=]+([\ ][A-Za-z0-9@._-]+)?$ ]]
+}
+_sa_sftp_exists()   { id -- "$1" >/dev/null 2>&1; }
+_sa_sftp_in_group() { id -nG -- "$1" 2>/dev/null | tr ' ' '\n' | grep -qx -- "$SA_SFTP_GROUP"; }
+_sa_sftp_group()    { getent group "$SA_SFTP_GROUP" >/dev/null 2>&1 || groupadd -- "$SA_SFTP_GROUP"; }
+
+# The sshd drop-in, on stdout.
+sa_sftp_render() {
+    printf 'Match Group %s\n' "$SA_SFTP_GROUP"
+    printf '    ChrootDirectory %s/%%u\n' "$SA_SFTP_BASE"
+    printf '    ForceCommand internal-sftp -d /files\n'
+    printf '    AuthorizedKeysFile %s/%%u\n' "$SA_SFTP_KEYDIR"
+    printf '    PasswordAuthentication no\n    KbdInteractiveAuthentication no\n'
+    printf '    PermitTTY no\n    X11Forwarding no\n    AllowTcpForwarding no\n    AllowAgentForwarding no\n'
+}
+
+# Installs the drop-in atomically; sshd -t must pass or the previous state is restored.
+sa_sftp_enable() {
+    local dir new backup=""
+    dir="$(dirname "$SA_SFTP_DROPIN")"
+    [ -d "$dir" ] || { echo "sftp: $dir does not exist" >&2; return 1; }
+    _sa_sftp_group || return 1
+    install -d -m 0755 -o root -g root -- "$SA_SFTP_BASE" "$SA_SFTP_KEYDIR" || return 1
+    new="$(mktemp "$dir/.sa-sftp.XXXXXX")" || return 1
+    sa_sftp_render > "$new" && chmod 0644 -- "$new" || { rm -f -- "$new"; return 1; }
+    if [ -f "$SA_SFTP_DROPIN" ]; then
+        backup="$(mktemp "$dir/.sa-sftp-bak.XXXXXX")" || { rm -f -- "$new"; return 1; }
+        cp -p -- "$SA_SFTP_DROPIN" "$backup"
+    fi
+    mv -f -- "$new" "$SA_SFTP_DROPIN" || { rm -f -- "$new" "$backup"; return 1; }
+    if ! sshd -t >&2; then
+        if [ -n "$backup" ]; then mv -f -- "$backup" "$SA_SFTP_DROPIN"; else rm -f -- "$SA_SFTP_DROPIN"; fi
+        echo "sftp: sshd -t failed; previous configuration restored" >&2; return 1
+    fi
+    if ! systemctl reload sshd; then
+        if [ -n "$backup" ]; then mv -f -- "$backup" "$SA_SFTP_DROPIN"; else rm -f -- "$SA_SFTP_DROPIN"; fi
+        echo "sftp: reload failed; previous configuration restored" >&2; return 1
+    fi
+    [ -z "$backup" ] || rm -f -- "$backup"
+}
+
+# sa_sftp_add_user <user> <public_key_file>   (re-running with the same user rotates the key)
+sa_sftp_add_user() {
+    local user=${1:-} keyfile=${2:-} key chroot tmp
+    _sa_sftp_user_ok "$user" || { echo "sftp: bad username" >&2; return 64; }
+    [ -f "$keyfile" ] || { echo "sftp: key file not found" >&2; return 64; }
+    key="$(<"$keyfile")"
+    _sa_sftp_key_ok "$key" || { echo "sftp: not a plain single-line public key" >&2; return 64; }
+    if _sa_sftp_exists "$user" && ! _sa_sftp_in_group "$user"; then
+        echo "sftp: $user is an existing non-SFTP account; refusing to modify it" >&2; return 1
+    fi
+    _sa_sftp_group || return 1
+    chroot="$SA_SFTP_BASE/$user"
+    if ! _sa_sftp_exists "$user"; then
+        useradd -g "$SA_SFTP_GROUP" -M -d "$chroot" -s /sbin/nologin -- "$user" || return 1
+    fi
+    # sshd requires the chroot path to be root-owned and not group/other-writable.
+    install -d -m 0755 -o root -g root -- "$SA_SFTP_BASE" "$SA_SFTP_KEYDIR" "$chroot" || return 1
+    install -d -m 0700 -o "$user" -g "$SA_SFTP_GROUP" -- "$chroot/files" || return 1
+    tmp="$(mktemp "$SA_SFTP_KEYDIR/.k.XXXXXX")" || return 1
+    printf '%s\n' "$key" > "$tmp" && chmod 0644 -- "$tmp" && chown root:root -- "$tmp" &&
+        mv -f -- "$tmp" "$SA_SFTP_KEYDIR/$user" || { rm -f -- "$tmp"; return 1; }
+    log "sftp: $user ready (chroot $chroot, upload dir /files)"
+}
+
+# sa_sftp_remove_user <user>  -- removes the login and key; the user's data is kept.
+sa_sftp_remove_user() {
+    local user=${1:-}
+    _sa_sftp_user_ok "$user" || { echo "sftp: bad username" >&2; return 64; }
+    _sa_sftp_in_group "$user" || { echo "sftp: $user is not an SFTP account; refusing" >&2; return 1; }
+    userdel -- "$user" || return 1
+    rm -f -- "$SA_SFTP_KEYDIR/$user"
+    log "sftp: removed login for $user; data kept in $SA_SFTP_BASE/$user"
+}
+
+sa_sftp_list() { getent group "$SA_SFTP_GROUP" 2>/dev/null | awk -F: '{ gsub(",", "\n", $4); print $4 }'; }
diff --git a/lib/tls.sh b/lib/tls.sh
--- a/lib/tls.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/tls.sh	2026-11-14 03:42:59.415808674 +0000
@@ -0,0 +1,97 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# lib/tls.sh -- ACME client adapter. Lego primary, Certbot fallback; shells out only.
+# Needs: log, sa_history_snapshot <path> [slug], sa_service_reload_safe <service> <snapshot-id>.
+# ZeroSSL EAB comes from env SA_TLS_EAB_KID / SA_TLS_EAB_HMAC. NOTE: the clients take
+# them as flags, so they are briefly visible in `ps`; keep the host single-tenant.
+. "$(dirname "${BASH_SOURCE[0]}")/common.sh"
+
+: "${SA_CERT_ROOT:=/etc/stackalign/certs}"
+
+_sa_tls_domain_ok() { [[ $1 =~ ^(\*\.)?([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,}$ ]]; }
+_sa_tls_lineage() { local d=$1; printf '%s' "${d/#\*./_wildcard_.}"; }
+_sa_tls_ca_url() {
+    case $1 in
+        letsencrypt) echo "https://acme-v02.api.letsencrypt.org/directory" ;;
+        zerossl)     echo "https://acme.zerossl.com/v2/DV90" ;;
+        *) return 1 ;;
+    esac
+}
+
+# Reports upstream schedulers; returns 2 if one is active.
+sa_tls_preflight() {
+    local found=0 t
+    for t in certbot.timer certbot-renew.timer snap.certbot.renew.timer; do
+        if systemctl is-active --quiet "$t" 2>/dev/null; then echo "scheduler: $t active"; found=1; fi
+    done
+    if { crontab -l 2>/dev/null; cat /etc/cron.d/* 2>/dev/null; } | grep -q 'acme\.sh'; then
+        echo "scheduler: acme.sh cron entry present"; found=1
+    fi
+    [ $found -eq 0 ] || return 2
+}
+
+# Refuses while an upstream scheduler is active unless SA_TLS_ALLOW_UPSTREAM=1.
+sa_tls_enable_renewal_timer() {
+    local rc=0
+    sa_tls_preflight >/dev/null || rc=$?
+    if [ $rc -eq 2 ] && [ "${SA_TLS_ALLOW_UPSTREAM:-0}" != 1 ]; then
+        echo "tls: upstream scheduler active; refusing (set SA_TLS_ALLOW_UPSTREAM=1 to override)" >&2
+        return 2
+    fi
+    systemctl enable --now stackalign-renew.timer
+}
+
+# sa_tls_issue <domain> <client> <ca> <challenge> <webroot|dns_provider> <email> <service>
+sa_tls_issue() {
+    [ $# -eq 7 ] || { echo "usage: sa_tls_issue domain client ca challenge webroot|provider email service" >&2; return 64; }
+    local domain=$1 client=$2 ca=$3 chal=$4 extra=$5 email=$6 svc=$7 url lin dir work snap crt key base
+    _sa_tls_domain_ok "$domain" || { echo "tls: bad domain: $domain" >&2; return 64; }
+    case $client in lego|certbot) ;; *) echo "tls: bad client: $client" >&2; return 64 ;; esac
+    url="$(_sa_tls_ca_url "$ca")" || { echo "tls: bad ca: $ca" >&2; return 64; }
+    [[ $email =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || { echo "tls: bad email" >&2; return 64; }
+    [[ $svc =~ ^[A-Za-z0-9_.@-]+$ ]] || { echo "tls: bad service" >&2; return 64; }
+    case $chal in
+        http-01) [[ $extra == /* && -d $extra ]] || { echo "tls: webroot must be an existing absolute dir" >&2; return 64; } ;;
+        dns-01)  [[ $extra =~ ^[a-z0-9-]+$ ]] || { echo "tls: bad dns provider" >&2; return 64; }
+                 [ "$client" = lego ] || { echo "tls: dns-01 needs lego" >&2; return 64; } ;;
+        *) echo "tls: bad challenge: $chal" >&2; return 64 ;;
+    esac
+    if [ "$ca" = zerossl ] && { [ -z "${SA_TLS_EAB_KID:-}" ] || [ -z "${SA_TLS_EAB_HMAC:-}" ]; }; then
+        echo "tls: zerossl needs SA_TLS_EAB_KID and SA_TLS_EAB_HMAC" >&2; return 1
+    fi
+
+    lin="$(_sa_tls_lineage "$domain")"; dir="$SA_CERT_ROOT/$lin"
+    if [ -f "$dir/.client" ] && [ "$(cat "$dir/.client")" != "$client" ]; then
+        echo "tls: $domain is owned by $(cat "$dir/.client"); refusing to switch to $client" >&2; return 1
+    fi
+    mkdir -p "$dir" || return 1
+    work="$(mktemp -d)" || return 1
+
+    if [ "$client" = lego ]; then
+        local args=(--path "$work" --email "$email" --accept-tos --server "$url" --domains "$domain")
+        [ "$ca" = zerossl ] && args+=(--eab --kid "$SA_TLS_EAB_KID" --hmac "$SA_TLS_EAB_HMAC")
+        if [ "$chal" = http-01 ]; then args+=(--http --http.webroot "$extra"); else args+=(--dns "$extra"); fi
+        lego "${args[@]}" run >&2 || { rm -rf "$work"; return 1; }
+        base="${domain/#\*/_}"
+        crt="$work/certificates/$base.crt"; key="$work/certificates/$base.key"
+    else
+        local cargs=(certonly --non-interactive --agree-tos -m "$email" --cert-name "$domain" -d "$domain"
+                     --server "$url" --webroot -w "$extra"
+                     --config-dir "$work/c" --work-dir "$work/w" --logs-dir "$work/l")
+        [ "$ca" = zerossl ] && cargs+=(--eab-kid "$SA_TLS_EAB_KID" --eab-hmac-key "$SA_TLS_EAB_HMAC")
+        certbot "${cargs[@]}" >&2 || { rm -rf "$work"; return 1; }
+        crt="$work/c/live/$domain/fullchain.pem"; key="$work/c/live/$domain/privkey.pem"
+    fi
+    if [ ! -s "$crt" ] || [ ! -s "$key" ]; then echo "tls: client produced no cert/key" >&2; rm -rf "$work"; return 1; fi
+
+    snap="$(sa_history_snapshot "$dir" "pre-tls-$lin")" || { rm -rf "$work"; echo "tls: snapshot failed" >&2; return 1; }
+    ( umask 077
+      cp -- "$crt" "$dir/.fullchain.new" && cp -- "$key" "$dir/.privkey.new" ) || { rm -rf "$work"; return 1; }
+    chmod 644 "$dir/.fullchain.new"; chmod 600 "$dir/.privkey.new"
+    mv -f -- "$dir/.fullchain.new" "$dir/fullchain.pem" && mv -f -- "$dir/.privkey.new" "$dir/privkey.pem" || { rm -rf "$work"; return 1; }
+    printf '%s\n' "$client" > "$dir/.client"
+    rm -rf "$work"
+    sa_service_reload_safe "$svc" "$snap" || { log "tls: reload failed; snapshot $snap holds the previous files"; return 1; }
+    log "tls: $domain issued by $client, deployed to $dir"
+}
diff --git a/lib/toml.sh b/lib/toml.sh
--- a/lib/toml.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/toml.sh	2026-11-14 03:42:59.923808692 +0000
@@ -0,0 +1,113 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# Parse a deliberately small TOML subset; this is not a full TOML implementation.
+declare -A TOML_DATA
+
+sa_toml_parse() {
+    local file="${1-}"
+    local line lineno=0 table="" table_kind="" array_index=-1
+    local key raw_value value full_key tail char next_char
+    local i length closed
+
+    TOML_DATA=()
+
+    if [[ -z "$file" || ! -r "$file" || ! -f "$file" ]]; then
+        printf 'toml: %s: file is not a readable regular file\n' "${file:-<missing>}" >&2
+        return 1
+    fi
+
+    local -A array_counts=()
+
+    while IFS= read -r line || [[ -n "$line" ]]; do
+        ((lineno += 1))
+        line="${line#"${line%%[![:space:]]*}"}"
+        line="${line%"${line##*[![:space:]]}"}"
+        [[ -z "$line" || "$line" == \#* ]] && continue
+
+        if [[ "$line" =~ ^\[\[[[:space:]]*([A-Za-z0-9_]+)[[:space:]]*\]\]$ ]]; then
+            table="${BASH_REMATCH[1]}"
+            table_kind="array"
+            if [[ -n "${array_counts[$table]+present}" ]]; then
+                array_index=${array_counts[$table]}
+            else
+                array_index=0
+            fi
+            array_counts["$table"]=$((array_index + 1))
+            continue
+        fi
+
+        if [[ "$line" =~ ^\[[[:space:]]*([A-Za-z0-9_]+)[[:space:]]*\]$ ]]; then
+            table="${BASH_REMATCH[1]}"
+            table_kind="simple"
+            array_index=-1
+            continue
+        fi
+
+        if [[ "$line" =~ ^([A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
+            key="${BASH_REMATCH[1]}"
+            raw_value="${BASH_REMATCH[2]}"
+            raw_value="${raw_value#"${raw_value%%[![:space:]]*}"}"
+            raw_value="${raw_value%"${raw_value##*[![:space:]]}"}"
+            if [[ -z "$raw_value" ]]; then
+                printf 'toml: %s:%d: missing value for key %s\n' "$file" "$lineno" "$key" >&2
+                TOML_DATA=(); return 1
+            fi
+            if [[ "${raw_value:0:1}" == '"' ]]; then
+                value=""; i=1; length=${#raw_value}; closed=0
+                while (( i < length )); do
+                    char="${raw_value:i:1}"
+                    if [[ "$char" == $'\\' ]]; then
+                        ((i += 1))
+                        if (( i >= length )); then break; fi
+                        next_char="${raw_value:i:1}"
+                        if [[ "$next_char" != '"' && "$next_char" != $'\\' ]]; then
+                            printf 'toml: %s:%d: unsupported string escape\\%s\n' "$file" "$lineno" "$next_char" >&2
+                            TOML_DATA=(); return 1
+                        fi
+                        value+="$next_char"
+                    elif [[ "$char" == '"' ]]; then
+                        closed=1
+                        tail="${raw_value:i+1}"
+                        tail="${tail#"${tail%%[![:space:]]*}"}"
+                        if [[ -n "$tail" && "${tail:0:1}" != '#' ]]; then
+                            printf 'toml: %s:%d: unexpected text after quoted string\n' "$file" "$lineno" >&2
+                            TOML_DATA=(); return 1
+                        fi
+                        break
+                    else
+                        value+="$char"
+                    fi
+                    ((i += 1))
+                done
+                if (( closed == 0 )); then
+                    printf 'toml: %s:%d: unterminated quoted string\n' "$file" "$lineno" >&2
+                    TOML_DATA=(); return 1
+                fi
+            elif [[ "$raw_value" =~ ^[+-]?(0|[1-9][0-9]*)$ || "$raw_value" == true || "$raw_value" == false ]]; then
+                value="$raw_value"
+            else
+                printf 'toml: %s:%d: unsupported or invalid value for key %s\n' "$file" "$lineno" "$key" >&2
+                TOML_DATA=(); return 1
+            fi
+            if [[ -n "$table" ]]; then
+                if [[ "$table_kind" == array ]]; then
+                    full_key="${table}.${array_index}.${key}"
+                else
+                    full_key="${table}.${key}"
+                fi
+            else
+                full_key="$key"
+            fi
+            if [[ -n "${TOML_DATA[$full_key]+present}" ]]; then
+                printf 'toml: %s:%d: duplicate key %s\n' "$file" "$lineno" "$full_key" >&2
+                TOML_DATA=(); return 1
+            fi
+            TOML_DATA["$full_key"]="$value"
+            continue
+        fi
+        printf 'toml: %s:%d: unsupported syntax: %s\n' "$file" "$lineno" "$line" >&2
+        TOML_DATA=(); return 1
+    done < "$file"
+    return 0
+}
diff --git a/lib/update.sh b/lib/update.sh
--- a/lib/update.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/update.sh	2026-11-14 03:42:58.807113886 +0000
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# lib/update.sh -- transactional package update with RPM rollback.
+# Needs: log, sa_history_snapshot <path> [slug], sa_cache_get,
+#        sa_service_health/sa_service_restart/sa_service_reload_safe (lib/service.sh).
+# Exit codes: 0 ok, 1 update failed and rolled back, 99 rollback failed.
+#
+# Real-contract notes (lib/service.sh):
+#   * sa_service_reload_safe <service> <snapshot-id> restores the CONFIG snapshot
+#     itself on failure, and calls `exit 99` when the service is still unhealthy.
+#     It runs in a subshell here so that exit 99 cannot skip the RPM rollback.
+#   * After `dnf downgrade` the service is restarted and health-checked again,
+#     because the running process may still be the new binary.
+
+# Usage: sa_update_apply <package> <target_nevra> <service> [snapshot_path]
+sa_update_apply() {
+    local pkg="${1:?package}" target="${2:?target nevra}" svc="${3:?service}"
+    local spath="${4:-/etc/$pkg}" old now snap slug rpm_path rc=0
+    old="$(rpm -q --qf '%{NEVRA}' "$pkg")" || { log "update: $pkg not installed"; return 1; }
+
+    # Also rejects services sa_service_health does not know (rc 64).
+    sa_service_health "$svc" || { log "update: $svc is not healthy before the update; refusing"; return 1; }
+    if [ ! -e "$spath" ]; then
+        log "update: snapshot path $spath not found; pass it as the 4th argument"
+        return 1
+    fi
+    slug="pre-update-${pkg//[^A-Za-z0-9_.-]/_}"
+    snap="$(sa_history_snapshot "$spath" "$slug")" || { log "update: snapshot failed"; return 1; }
+    [ -n "$snap" ] || { log "update: empty snapshot id"; return 1; }
+    log "update: $pkg $old -> $target (snapshot $snap of $spath)"
+
+    rpm_path="$(sa_cache_get "$target")" || { log "update: cannot fetch $target"; return 1; }
+
+    if dnf -y install "$rpm_path"; then
+        ( sa_service_reload_safe "$svc" "$snap" ) || rc=$?
+        if [ "$rc" -eq 0 ]; then
+            log "update: $pkg -> $target ok"
+            return 0
+        fi
+        log "update: service check failed (rc=$rc), rolling back to $old"
+    else
+        now="$(rpm -q --qf '%{NEVRA}' "$pkg" 2>/dev/null)" || now=""
+        if [ "$now" = "$old" ]; then
+            log "update: dnf install failed; package unchanged"
+            return 1
+        fi
+        log "update: dnf install failed part-way, rolling back to $old"
+    fi
+
+    if ! dnf -y downgrade "$old"; then
+        log "update: ROLLBACK FAILED, manual repair needed ($old)"
+        return 99
+    fi
+    if sa_service_restart "$svc" && sa_service_health "$svc"; then
+        log "update: rolled back to $old"
+        return 1
+    fi
+    log "update: $svc unhealthy after downgrade to $old; manual repair needed"
+    return 99
+}
diff --git a/lib/watchtower.sh b/lib/watchtower.sh
--- a/lib/watchtower.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/watchtower.sh	2026-11-14 03:42:59.039808660 +0000
@@ -0,0 +1,71 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# lib/watchtower.sh -- advisory audit. Observes and scores; never changes anything.
+
+
+
+. "$(dirname "${BASH_SOURCE[0]}")/common.sh"
+
+: "${SA_WATCHTOWER_QUEUE:=/var/lib/stackalign/watchtower-queue.jsonl}"
+
+_sa_json_escape() {
+    local s="$1"
+    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
+    s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
+    printf '%s' "$s"
+}
+
+_sa_emit_finding() {
+    printf '{"severity":"%s","component":"%s","message":"%s"}\n' \
+        "$(_sa_json_escape "$1")" "$(_sa_json_escape "$2")" "$(_sa_json_escape "$3")" \
+        >> "$SA_WATCHTOWER_QUEUE"
+}
+
+# Repo checks only (safe in CI; queue path must be writable).
+sa_watchtower_scan() {
+    local root="${1:-.}"
+    mkdir -p "$(dirname "$SA_WATCHTOWER_QUEUE")" || return 1
+    : > "$SA_WATCHTOWER_QUEUE"
+    log "Watchtower: scanning $root"
+
+    grep -q "sa_toml_parse" "$root/lib/repo.sh" 2>/dev/null ||
+        _sa_emit_finding HIGH lib/repo.sh "TOML parser not integrated."
+    grep -rq "sa_cache_get" "$root/lib" 2>/dev/null ||
+        _sa_emit_finding HIGH lib "RPM cache (sa_cache_get) missing."
+    grep -rq "dnf -y downgrade" "$root/lib" "$root/bin" 2>/dev/null ||
+        _sa_emit_finding CRITICAL bin/stackalign "Update rollback (dnf -y downgrade) missing."
+
+    if [ -d "$root/templates/nginx" ] && [ -n "$(find "$root/templates/nginx" -type f 2>/dev/null)" ]; then
+        grep -rqi "claudebot" "$root/templates/nginx" ||
+            _sa_emit_finding HIGH templates/nginx "AI crawler map missing ClaudeBot."
+        grep -rq "fastcgi_no_cache" "$root/templates/nginx" ||
+            _sa_emit_finding CRITICAL templates/nginx "fastcgi_no_cache missing."
+        grep -rq "fastcgi_cache_bypass" "$root/templates/nginx" ||
+            _sa_emit_finding CRITICAL templates/nginx "fastcgi_cache_bypass missing."
+    else
+        _sa_emit_finding MED templates/nginx "Nginx templates missing."
+    fi
+    _sa_watchtower_summary
+}
+
+# Live-host checks (run on the server, usually as root).
+sa_watchtower_live() {
+    mkdir -p "$(dirname "$SA_WATCHTOWER_QUEUE")" || return 1
+    if command -v nginx >/dev/null 2>&1 && ! nginx -t >/dev/null 2>&1; then
+        _sa_emit_finding CRITICAL nginx "Live nginx -t failed."
+    fi
+    if command -v mysqladmin >/dev/null 2>&1 && ! mysqladmin ping >/dev/null 2>&1; then
+        _sa_emit_finding CRITICAL mariadb "MariaDB not responding to ping."
+    fi
+    _sa_watchtower_summary
+}
+
+_sa_watchtower_summary() {
+    echo "--- Watchtower findings ---"
+    if [ -s "$SA_WATCHTOWER_QUEUE" ]; then
+        while IFS= read -r line; do echo "  $line"; done < "$SA_WATCHTOWER_QUEUE"
+    else
+        echo "  No issues found."
+    fi
+}
diff --git a/tests/test_backup.sh b/tests/test_backup.sh
--- a/tests/test_backup.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_backup.sh	2026-11-14 03:43:00.907808727 +0000
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# tests/test_backup.sh
+set -u
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
+mkdir -p "$T/bin"; : > "$T/calls"
+export CALLS="$T/calls" PATH="$T/bin:$PATH"
+fail=0
+check() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1 (got '$2' want '$3')"; fail=1; fi; }
+mkfake() { printf "%s
+" "#!/usr/bin/env bash" "$2" > "$T/bin/$1"; chmod +x "$T/bin/$1"; }
+mkfake mysqldump 'echo "mysqldump $*" >> "$CALLS"; [ "${FAKE_DUMP_FAIL:-0}" = 1 ] && exit 1; echo "SELECT 1;"'
+mkfake mariabackup 'echo "mariabackup $*" >> "$CALLS"; for a in "$@"; do case "$a" in --target-dir=*) mkdir -p "${a#--target-dir=}";; esac; done'
