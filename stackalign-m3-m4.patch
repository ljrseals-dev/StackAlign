@@ -0,0 +1,88 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# tests/test_update.sh -- sa_update_apply against the REAL service.sh contract
+# (reload_safe may `exit 99`; downgrade must be followed by restart + health).
+set -u
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
+mkdir -p "$T/bin" "$T/etc-pkg"; : > "$T/calls"; echo OLD-1.0-1.x86_64 > "$T/installed"
+export CALLS="$T/calls" PATH="$T/bin:$PATH"
+
+cat > "$T/bin/dnf" <<'F'
+#!/usr/bin/env bash
+echo "dnf $*" >> "$CALLS"
+case "$*" in
+  *downgrade*) [ "${FAKE_DOWNGRADE_RC:-0}" = 0 ] && echo OLD-1.0-1.x86_64 > "$STATE"; exit "${FAKE_DOWNGRADE_RC:-0}" ;;
+  *install*)   [ "${FAKE_INSTALL_RC:-0}" = 0 ] && echo NEW-2.0-1.x86_64 > "$STATE"
+               [ "${FAKE_INSTALL_PARTIAL:-0}" = 1 ] && echo NEW-2.0-1.x86_64 > "$STATE"
+               exit "${FAKE_INSTALL_RC:-0}" ;;
+esac
+exit 0
+F
+cat > "$T/bin/rpm" <<'F'
+#!/usr/bin/env bash
+cat "$STATE"
+F
+chmod +x "$T/bin/"*
+export STATE="$T/installed"
+
+log() { :; }
+sa_history_snapshot() { echo "snapshot $*" >> "$CALLS"; echo SNAP42; }
+sa_cache_get() { echo "$T/NEW.rpm"; }
+HC="$T/healthcount"
+sa_service_health() {
+    echo "health $*" >> "$CALLS"
+    local n; n=$(( $(cat "$HC" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$HC"
+    [ "${FAKE_HEALTH_FAIL_FROM:-0}" -gt 0 ] && [ "$n" -ge "$FAKE_HEALTH_FAIL_FROM" ] && return 1
+    [ "$1" = bogus ] && return 64
+    return 0
+}
+sa_service_restart() { echo "restart $*" >> "$CALLS"; return "${FAKE_RESTART_RC:-0}"; }
+sa_service_reload_safe() {
+    echo "reload $*" >> "$CALLS"
+    [ "${FAKE_RELOAD_EXIT99:-0}" = 1 ] && exit 99      # the real helper does this
+    return "${FAKE_RELOAD_RC:-0}"
+}
+. "$ROOT/lib/update.sh"
+
+fail=0
+check() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1 (got '$2' want '$3')"; fail=1; fi; }
+reset() { : > "$CALLS"; : > "$HC"; echo OLD-1.0-1.x86_64 > "$STATE"; unset FAKE_RELOAD_RC FAKE_RELOAD_EXIT99 FAKE_DOWNGRADE_RC FAKE_INSTALL_RC FAKE_INSTALL_PARTIAL FAKE_HEALTH_FAIL_FROM FAKE_RESTART_RC; }
+has() { grep -q -- "$1" "$CALLS"; }
+run() { ( sa_update_apply pkg NEW-2.0-1.x86_64 svc "$T/etc-pkg" ) >/dev/null 2>&1; }
+
+reset; run; check "success => 0" "$?" 0
+has "dnf -y downgrade"; check "no downgrade on success" "$?" 1
+has "snapshot $T/etc-pkg pre-update-pkg"; check "snapshot: one path + slug" "$?" 0
+has "reload svc SNAP42"; check "reload got service + snapshot id" "$?" 0
+
+reset; export FAKE_RELOAD_RC=1; run; check "reload fails, downgrade ok => 1" "$?" 1
+has "dnf -y downgrade OLD-1.0-1.x86_64"; check "downgrade to old NEVRA" "$?" 0
+has "restart svc"; check "restart after downgrade" "$?" 0
+
+reset; export FAKE_RELOAD_EXIT99=1; run; check "reload_safe exit 99 is caught => rollback => 1" "$?" 1
+has "dnf -y downgrade OLD-1.0-1.x86_64"; check "downgrade still attempted after exit 99" "$?" 0
+
+reset; export FAKE_RELOAD_RC=1 FAKE_DOWNGRADE_RC=1; run; check "downgrade fails => 99" "$?" 99
+
+reset; export FAKE_RELOAD_RC=1 FAKE_HEALTH_FAIL_FROM=2; run; check "unhealthy after downgrade => 99" "$?" 99
+reset; export FAKE_RELOAD_RC=1 FAKE_RESTART_RC=1; run; check "restart fails after downgrade => 99" "$?" 99
+
+reset; export FAKE_HEALTH_FAIL_FROM=1; run; check "unhealthy before update => refuse (1)" "$?" 1
+has "dnf"; check "no dnf when unhealthy" "$?" 1
+
+reset; ( sa_update_apply pkg NEW-2.0-1.x86_64 bogus "$T/etc-pkg" ) >/dev/null 2>&1; check "unknown service refused" "$?" 1
+has "dnf"; check "no dnf for unknown service" "$?" 1
+
+reset; export FAKE_INSTALL_RC=1; run; check "install fails, unchanged => 1" "$?" 1
+has "downgrade"; check "no downgrade when nothing changed" "$?" 1
+reset; export FAKE_INSTALL_RC=1 FAKE_INSTALL_PARTIAL=1; run; check "install fails part-way => rollback => 1" "$?" 1
+has "dnf -y downgrade OLD-1.0-1.x86_64"; check "downgrade after partial install" "$?" 0
+
+reset; ( sa_update_apply pkg NEW-2.0-1.x86_64 svc "$T/missing" ) >/dev/null 2>&1; check "missing snapshot path => 1" "$?" 1
+has "dnf"; check "no dnf when refused" "$?" 1
+
+reset; ( sa_update_apply 'lib++' NEW-2.0-1.x86_64 svc "$T/etc-pkg" ) >/dev/null 2>&1
+has "snapshot $T/etc-pkg pre-update-lib__"; check "slug sanitised (lib++ -> lib__)" "$?" 0
+exit "$fail"
diff --git a/tests/test_update_cli.sh b/tests/test_update_cli.sh
--- a/tests/test_update_cli.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_update_cli.sh	2026-11-14 03:43:19.666327542 +0000
@@ -0,0 +1,106 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: MIT
+# Author: Lewis James Seals Jr.
+# tests/test_update_cli.sh -- CLI-level proof, using the REAL history.sh and service.sh:
+# exit codes 0/1/99 reach the shell, config is restored, the RPM is downgraded.
+set -u
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+CLI="$ROOT/bin/stackalign"
+W="$(mktemp -d)"; trap 'rm -rf "$W"' EXIT
+mkdir -p "$W/bin" "$W/etc-nginx" "$W/cache"
+
+TARGET="nginx-1.31.0-1.el9.x86_64"
+OLD="nginx-1.30.6-1.el9.x86_64"
+export FAKE_TARGET="$TARGET" STATE="$W/installed" NEWF="$W/new" ETC="$W/etc-nginx" DNF_LOG="$W/dnf.log"
+export SA_HISTORY_ROOT="$W/hist" SA_SECRETS_DIR="$W/secrets" SA_RPM_CACHE="$W/cache"
+: > "$W/cache/$TARGET.rpm"                 # pre-seeded: no real download
+
+# dnf: install = new binary + new config; downgrade = old binary (new marker removed)
+cat > "$W/bin/dnf" <<'F'
+#!/usr/bin/env bash
+echo "dnf $*" >> "$DNF_LOG"
+case "$*" in
+  *downgrade*) [ "${DNF_DOWNGRADE_RC:-0}" = 0 ] || exit "$DNF_DOWNGRADE_RC"
+               echo "nginx-1.30.6-1.el9.x86_64" > "$STATE"; rm -f "$NEWF"; exit 0 ;;
+  *install*)   echo "nginx-1.31.0-1.el9.x86_64" > "$STATE"; : > "$NEWF"; echo new > "$ETC/nginx.conf"; exit 0 ;;
+esac
+exit 0
+F
+# rpm: -qp => the package file's NEVRA; -q --qf => installed NEVRA from state
+cat > "$W/bin/rpm" <<'F'
+#!/usr/bin/env bash
+case "$*" in
+  *"-qp"*) printf '%s' "$FAKE_TARGET" ;;
+  *"--qf"*) cat "$STATE" ;;
+esac
+exit 0
+F
+# systemctl: queries ok; reload/restart fail while the NEW binary is installed (unless NEW_OK=1)
+cat > "$W/bin/systemctl" <<'F'
+#!/usr/bin/env bash
+case "$1" in
+  is-active) exit 0 ;;
+  reload|restart) if [ -e "$NEWF" ] && [ "${NEW_OK:-0}" != 1 ]; then exit 1; fi; exit 0 ;;
+esac
+exit 0
+F
+# nginx -t: fails while the NEW binary is installed iff NEW_BROKEN=1
+cat > "$W/bin/nginx" <<'F'
+#!/usr/bin/env bash
+if [ -e "$NEWF" ] && [ "${NEW_BROKEN:-0}" = 1 ]; then exit 1; fi
+exit 0
+F
+chmod +x "$W/bin/"*
+export PATH="$W/bin:$PATH"
+echo "$OLD" > "$STATE"
+
+pass=0; fail=0
+ok()  { pass=$((pass+1)); echo "ok   - $1"; }
+bad() { fail=$((fail+1)); echo "FAIL - $1"; [ -s "$DNF_LOG" ] && sed 's/^/       dnf: /' "$DNF_LOG"; }
+reset() { : > "$DNF_LOG"; echo "$OLD" > "$STATE"; rm -f "$NEWF"; echo old > "$ETC/nginx.conf"; rm -rf "$W/hist"
+          unset DNF_DOWNGRADE_RC NEW_OK NEW_BROKEN; }
+apply() { OUT=$("$CLI" update apply nginx "$TARGET" nginx "$ETC" --apply 2>&1); RC=$?; }
+logged() { grep -q -- "$1" "$DNF_LOG"; }
+
+reset; export NEW_OK=1; apply
+[ $RC -eq 0 ] && ok "healthy update => exit 0" || bad "healthy update => exit 0 (rc=$RC) $OUT"
+! logged "downgrade" && ok "no downgrade on success" || bad "no downgrade on success"
+[ "$(cat "$ETC/nginx.conf")" = new ] && ok "new config kept on success" || bad "new config kept on success"
+
+reset; apply
+[ $RC -eq 1 ] && ok "reload fails => rolled back => exit 1" || bad "reload fails => exit 1 (rc=$RC) $OUT"
+logged "dnf -y install" && logged "dnf -y downgrade $OLD" && ok "install then downgrade to old NEVRA" || bad "install then downgrade to old NEVRA"
+[ "$(cat "$ETC/nginx.conf")" = old ] && ok "config restored from snapshot" || bad "config restored from snapshot"
+[ "$(cat "$STATE")" = "$OLD" ] && ok "package back at old NEVRA" || bad "package back at old NEVRA"
+
+reset; export NEW_BROKEN=1; apply
+[ $RC -eq 1 ] && ok "new binary broken (reload_safe exit 99 caught) => recovered => exit 1" || bad "broken new binary => exit 1 (rc=$RC) $OUT"
+logged "dnf -y downgrade $OLD" && ok "downgrade still attempted after reload_safe exit 99" || bad "downgrade still attempted after exit 99"
+[ "$(cat "$ETC/nginx.conf")" = old ] && ok "config restored (broken-binary case)" || bad "config restored (broken-binary case)"
+
+reset; export DNF_DOWNGRADE_RC=1; apply
+[ $RC -eq 99 ] && ok "downgrade fails => exit 99" || bad "downgrade fails => exit 99 (rc=$RC) $OUT"
+
+reset; OUT=$("$CLI" update apply nginx "$TARGET" nginx "$ETC" 2>&1); RC=$?
+{ [ $RC -eq 0 ] && [[ $OUT == *"plan:"* ]] && [[ $OUT == *"--apply"* ]]; } && ok "no --apply => plan only, exit 0" || bad "plan mode (rc=$RC)"
+[ ! -s "$DNF_LOG" ] && [ "$(cat "$ETC/nginx.conf")" = old ] && ok "plan mode changes nothing" || bad "plan mode changes nothing"
+
+reset; OUT=$("$CLI" --plan update apply nginx "$TARGET" nginx "$ETC" --apply 2>&1); RC=$?
+[ $RC -eq 64 ] && ok "--plan with --apply => 64" || bad "--plan with --apply => 64 (rc=$RC)"
+
+reset; OUT=$("$CLI" plan update apply nginx "$TARGET" nginx "$ETC" 2>&1); RC=$?
+{ [ $RC -eq 0 ] && [ ! -s "$DNF_LOG" ]; } && ok "plan <cmd> alias is read-only" || bad "plan alias (rc=$RC)"
+
+reset; OUT=$("$CLI" update apply nginx "$TARGET" --apply 2>&1); RC=$?
+{ [ $RC -eq 64 ] && [ ! -s "$DNF_LOG" ]; } && ok "bad arg count => 64, no dnf" || bad "bad arg count (rc=$RC)"
+
+reset; OUT=$("$CLI" update apply nginx "$TARGET" apache "$ETC" --apply 2>&1); RC=$?
+{ [ $RC -eq 1 ] && [ ! -s "$DNF_LOG" ]; } && ok "unknown service refused before any change" || bad "unknown service (rc=$RC)"
+
+reset; OUT=$("$CLI" update check 2>&1); RC=$?
+{ [ $RC -eq 2 ] && [[ $OUT == *"not implemented"* ]]; } && ok "update check is an honest stub (rc 2)" || bad "update check stub (rc=$RC)"
+
+reset; OUT=$("$CLI" update bogus 2>&1); RC=$?
+[ $RC -eq 64 ] && ok "unknown update subcommand => 64" || bad "unknown update subcommand (rc=$RC)"
+
+echo "passed=$pass failed=$fail"; [ $fail -eq 0 ]
