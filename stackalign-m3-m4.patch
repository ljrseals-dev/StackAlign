+
+rm -rf "$T/out2"; FAKE_DUMP_FAIL=1 sa_backup_dump "$T/out2" >/dev/null 2>&1; check "dump failure => rc 1" "$?" 1
+check "failed dump leaves no file" "$(ls "$T/out2" 2>/dev/null | wc -l | tr -d ' ')" 0
+sa_backup_dump "../x" >/dev/null 2>&1; check "bad dest dir" "$?" 64
+( unset SA_MYSQL_DEFAULTS_FILE; sa_backup_dump "$T/out3" >/dev/null 2>&1 ); check "missing defaults file" "$?" 64
