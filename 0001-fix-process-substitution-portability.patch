From a8338151a3884ea395ed687d8e80df930223d97c Mon Sep 17 00:00:00 2001
From: "Lewis James Seals Jr." <ljrseals@gmail.com>
Date: Thu, 12 Nov 2026 20:02:16 +0000
Subject: [PATCH] fix: portable cmp for repo/render idempotency

Replace process-substitution cmp targets with real temp files.
On some environments /dev/fd process substitution makes cmp report
a mismatch even when bytes are identical, so sa_repo_setup and
sa_render_apply always rewrote and failed the idempotent tests.

Verified: make test RESULT: all suites passed (T1-T28 included).
---
 lib/render.sh |  7 ++++++-
 lib/repo.sh   | 14 ++++++++++----
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/lib/render.sh b/lib/render.sh
index 8a9419c..e657ffa 100644
--- a/lib/render.sh
+++ b/lib/render.sh
@@ -47,9 +47,14 @@ sa_render_plan() {  # <template> <output> <map-var-name>
 sa_render_apply() {  # <template> <output> <map-var-name>
   local tpl=$1 output=$2 mapname=$3 rendered tmp
   _sa_render_to_var "$tpl" "$mapname" rendered || return $?
-  if [ -f "$output" ] && cmp -s -- "$output" <(printf '%s' "$rendered"); then
+  local _sa_cmp
+  _sa_cmp=$(mktemp) || return 1
+  printf '%s' "$rendered" > "$_sa_cmp" || { rm -f -- "$_sa_cmp"; return 1; }
+  if [ -f "$output" ] && cmp -s -- "$output" "$_sa_cmp"; then
+    rm -f -- "$_sa_cmp"
     echo "unchanged: $output"; return 0
   fi
+  rm -f -- "$_sa_cmp"
   if declare -F sa_history_snapshot >/dev/null; then
     sa_history_snapshot "$output" render >/dev/null || return $?
   fi
diff --git a/lib/repo.sh b/lib/repo.sh
index 9953a09..2305ae9 100644
--- a/lib/repo.sh
+++ b/lib/repo.sh
@@ -62,14 +62,20 @@ sa_repo_setup() {  # <name> <repo_url> <gpg_fingerprint> <gpg_key_url>
   content=$(printf '[stackalign-%s]\nname=StackAlign %s\nbaseurl=%s\nenabled=1\ngpgcheck=1\ngpgkey=%s\n' \
             "$name" "$name" "$url" "$keyurl"; printf x); content=${content%x}
   mkdir -p -- "$SA_YUM_REPOS_DIR"
-  if [ -f "$file" ] && cmp -s -- "$file" <(printf '%s' "$content"); then
+  # Avoid process-substitution in cmp: under some environments /dev/fd compares
+  # fail even when bytes are identical, which breaks setup idempotency.
+  local cmpfile
+  cmpfile=$(mktemp "$SA_YUM_REPOS_DIR/.sa-repo-cmp.XXXXXX") || { rm -rf "$tmpd"; return 1; }
+  printf '%s' "$content" > "$cmpfile" || { rm -rf "$tmpd" "$cmpfile"; return 1; }
+  if [ -f "$file" ] && cmp -s -- "$file" "$cmpfile"; then
+    rm -f -- "$cmpfile"
     echo "repo $name: unchanged"
   else
-    local tmp; tmp=$(mktemp "$SA_YUM_REPOS_DIR/.sa-repo.XXXXXX") || { rm -rf "$tmpd"; return 1; }
-    printf '%s' "$content" > "$tmp" && chmod 0644 "$tmp" && mv -f -- "$tmp" "$file" \
-      || { rm -rf "$tmpd" "$tmp"; return 1; }
+    chmod 0644 -- "$cmpfile" || { rm -rf "$tmpd" "$cmpfile"; return 1; }
+    mv -f -- "$cmpfile" "$file" || { rm -rf "$tmpd" "$cmpfile"; return 1; }
     echo "repo $name: written"
   fi
+
   rpm --import "$key" || { rm -rf "$tmpd"; echo "repo: rpm --import failed" >&2; return 1; }
   rm -rf "$tmpd"
 }
